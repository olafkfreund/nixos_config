+
+  // Temporary #3165 stall marker: logs when the main loop missed its 50 ms tick by more than 100 ms.
+  Timer {
+    id: startupStallTimer
+    property double last: 0
+    property bool stopped: false
+    interval: 50
+    repeat: true
+    running: shell.startupTiming && !stopped
+    onTriggered: {
+      var now = Date.now()
+      if (last && now - last > 150) console.log("startup-timing", "stall", now - last)
+      last = now
+    }
+  }
+  Timer {
+    interval: 20000
+    running: shell.startupTiming
+    onTriggered: startupStallTimer.stopped = true
+  }
