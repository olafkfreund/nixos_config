 static void
+start_next_waiting (void)
+{
+	static gboolean draining = FALSE;
+	GkdSecretUnlock *self;
+
+	if (draining)
+		return;
+	draining = TRUE;
+	while (unlock_in_flight == NULL &&
+	       (self = g_queue_pop_head (&unlock_prompt_queue)) != NULL) {
+		perform_next_unlock (self);
+		g_object_unref (self);
+	}
+	draining = FALSE;
+}
