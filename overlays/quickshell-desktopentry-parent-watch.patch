-void DesktopEntryMonitor::onDirectoryChanged(const QString& /*path*/) {
+void DesktopEntryMonitor::onDirectoryChanged(const QString& path) {
+	if (this->appDirs.contains(path)) {
+		this->debounceTimer.start();
+		return;
+	}
+
+	// A parent changed. Only rescan if an applications directory now resolves elsewhere.
+	auto changed = false;
+	for (const auto& p: DesktopEntryManager::desktopPaths()) {
+		if (QFileInfo(p).canonicalFilePath() != this->canonical.value(p)) {
+			changed = true;
+			break;
+		}
+	}
+
+	if (!changed) return;
+	this->startMonitoring();
 	this->debounceTimer.start();
 }
 
