+        private static string ReadDrainRequest(string path)
+        {
+            if (!File.Exists(path)) return null;
+            using var request = JsonDocument.Parse(File.ReadAllText(path));
+            string id = request.RootElement.GetProperty("id").GetString();
+            if (!Guid.TryParse(id, out _)) throw new InvalidDataException("Invalid runner drain request ID.");
+            return id;
+        }
+
+        private static void WriteDrainAck(string path, string id, string state)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(path));
+            string temporary = path + "." + Guid.NewGuid() + ".tmp";
+            try
+            {
+                File.WriteAllText(temporary, JsonSerializer.Serialize(new
+                {
+                    id,
+                    invocation = Environment.GetEnvironmentVariable("INVOCATION_ID"),
+                    state
+                }));
+                File.Move(temporary, path, true);
+            }
+            finally
+            {
+                if (File.Exists(temporary)) File.Delete(temporary);
+            }
+        }
 
