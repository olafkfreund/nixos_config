+        private string ReadDrainRequest(string path)
+        {
+            try
+            {
+                using var request = JsonDocument.Parse(DrainRequestReader(path));
+                if (request.RootElement.ValueKind != JsonValueKind.Object ||
+                    !request.RootElement.TryGetProperty("id", out var id) ||
+                    id.ValueKind != JsonValueKind.String ||
+                    !Guid.TryParse(id.GetString(), out _)) return null;
+                return id.GetString();
+            }
+            catch (Exception ex) when (ex is IOException || ex is UnauthorizedAccessException ||
+                ex is System.Security.SecurityException || ex is JsonException)
+            {
+                return null;
+            }
+        }
+
+        private static void WriteDrainAck(string path, string id, string state)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(path));
+            string temporary = path + "." + Guid.NewGuid() + ".tmp";
+            try
+            {
+                File.WriteAllText(temporary, JsonSerializer.Serialize(new
+                {
+                    id,
+                    invocation = Environment.GetEnvironmentVariable("INVOCATION_ID"),
+                    state
+                }));
+                File.Move(temporary, path, true);
+            }
+            finally
+            {
+                if (File.Exists(temporary)) File.Delete(temporary);
+            }
+        }
+
+        private bool TryWriteDrainAck(string path, string id, string state)
+        {
+            try
+            {
+                WriteDrainAck(path, id, state);
+                return true;
+            }
+            catch (Exception ex) when (ex is IOException || ex is UnauthorizedAccessException || ex is System.Security.SecurityException)
+            {
+                Trace.Error($"Failed to write drain acknowledgement '{state}' for '{id}': {ex}");
+                return false;
+            }
+        }
 
