new file mode 100644
index 0000000..3e4ac1e
--- /dev/null
+++ b/herdr_claude_teams/hc_client.py
@@ -0,0 +1,140 @@
+"""Herdr-shaped calls backed by hc terminals and herdr-app tabs."""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+
+from . import ownership
+from .socket_client import HerdrError
+
+
+def _run(*argv: str, json_result: bool = False):
+    result = subprocess.run(argv, text=True, capture_output=True, check=False)
+    if result.returncode:
+        raise HerdrError("hc_error", result.stderr.strip() or result.stdout.strip())
+    if json_result:
+        try:
+            return json.loads(result.stdout)
+        except ValueError as exc:
+            raise HerdrError("invalid_response", f"{argv[0]} returned invalid JSON") from exc
+    return result.stdout
+
+
+def _listing() -> dict:
+    return _run("herdr-app", "ls", json_result=True)
+
+
+def _panes(listing: dict) -> list[dict]:
+    leader = os.environ["HC_TERMINAL_ID"]
+    panes = []
+    for space in listing.get("spaces", []):
+        for tab in space.get("tabs", []):
+            for entry in tab.get("terminals", []):
+                address = entry if isinstance(entry, str) else entry.get("terminal") or entry.get("address") or entry.get("id")
+                if address != leader and not ownership.is_owned(address):
+                    continue
+                panes.append({
+                    "pane_id": address, "terminal_id": address, "tab_id": tab["id"],
+                    "workspace_id": space["id"], "focused": address == leader,
+                    "label": tab.get("name", ""),
+                })
+    return panes
+
+
+def _pane(address: str) -> dict:
+    pane = next((p for p in _panes(_listing()) if p["pane_id"] == address), None)
+    if pane is None:
+        raise HerdrError("pane_not_found", f"pane {address} not found")
+    return pane
+
+
+def _app(command: str, **params):
+    result = _run("herdr-app", "do", command, json.dumps(params), json_result=True)
+    if isinstance(result, dict) and result.get("error"):
+        raise HerdrError("app_error", str(result["error"]))
+    return result
+
+
+def call(method: str, params: dict) -> dict:
+    address = params.get("pane_id", "")
+    if method == "pane.get":
+        return {"type": "pane_info", "pane": _pane(address)}
+    if method == "pane.list":
+        return {"type": "pane_list", "panes": _panes(_listing())}
+    if method == "pane.close":
+        if not ownership.is_owned(address):
+            raise HerdrError("not_owned", f"pane {address} is not owned")
+        _run("hc", "kill", address)
+        return {"type": "ok"}
+    if method == "pane.read":
+        _pane(address)
+        text = _run("hc", "read", "--lines", "1000" if params.get("source") == "recent" else "0", address)
+        return {"type": "pane_read", "read": {"pane_id": address, "text": text, "source": params.get("source", "visible"), "truncated": False}}
+    if method == "pane.send_text":
+        _pane(address)
+        text = params.get("text", "")
+        if text == "\x03":
+            _run("hc", "interrupt", address)
+        elif text.endswith("\r"):
+            if text == "\r":
+                _run("hc", "keys", address, "enter")
+            else:
+                _run("hc", "send", address, text[:-1])
+        elif text:
+            # hc keys types without submitting; send-keys -l may precede Enter.
+            _run("hc", "keys", address, *("space" if c == " " else c for c in text))
+        return {"type": "ok"}
+    if method == "pane.process_info":
+        _pane(address)
+        state = _run("hc", "get", address, "--json", json_result=True)
+        argv = (state.get("foreground") or {}).get("argv") or []
+        return {"type": "pane_process_info", "foreground_processes": [{"argv": argv}] if argv else []}
+    if method == "pane.rename":
+        pane = _pane(address)
+        _app("tab.rename", id=pane["tab_id"], name=params.get("label", ""))
+        pane["label"] = params.get("label", "")
+        return {"type": "pane_info", "pane": pane}
+    if method == "pane.report_metadata":
+        tokens = params.get("tokens") or {}
+        label = tokens.get("split_mark")
+        if label and ownership.is_owned(address):
+            _app("tab.rename", id=_pane(address)["tab_id"], name=label)
+        return {"type": "ok"}
+    if method == "pane.resize":
+        return {"type": "pane_resize", "resize": {}}
+    if method == "pane.layout":
+        pane = _pane(address)
+        area = {"x": 0, "y": 0, "width": 200, "height": 50}
+        return {"type": "pane_layout", "layout": {"area": area, "focused_pane_id": address, "panes": [{"pane_id": address, "focused": True, "rect": area}], "splits": [], "tab_id": pane["tab_id"], "workspace_id": pane["workspace_id"], "zoomed": False}}
+    if method == "pane.move":
+        return {"type": "pane_move", "move_result": {"changed": False}}
+    if method == "tab.create":
+        before = _pane(os.environ["HC_TERMINAL_ID"])
+        # A plain shell, not a `cat` placeholder: in an app terminal cat survives ^C,
+        # so respawn-pane would type the teammate's command into cat.
+        created = _app("tab.new", space=params.get("workspace_id"), name=params.get("label", "teammate"), **({"folder": params["cwd"]} if params.get("cwd") else {}))
+        # tab.new focuses the new tab (no focus argument); give the lead its tab back.
+        _app("tab.select", id=before["tab_id"])
+        pane = {"pane_id": created["terminal"], "terminal_id": created["terminal"], "tab_id": created["tab"], "workspace_id": created["space"], "focused": False}
+        return {"type": "tab_created", "tab": {"tab_id": created["tab"], "workspace_id": created["space"]}, "root_pane": pane}
+    if method == "tab.list":
+        return {"type": "tab_list", "tabs": [{"tab_id": tab["id"], "workspace_id": space["id"], "label": tab.get("name", "")} for space in _listing().get("spaces", []) for tab in space.get("tabs", []) if not params.get("workspace_id") or params["workspace_id"] == space["id"]]}
+    if method == "tab.rename":
+        _app("tab.rename", id=params["tab_id"], name=params.get("label", ""))
+        return {"type": "ok"}
+    if method == "tab.move":
+        _app("tab.move", id=params["tab_id"], index=params["insert_index"] + 1)
+        return {"type": "ok"}
+    if method == "tab.focus":
+        _app("tab.select", id=params["tab_id"])
+        return {"type": "ok"}
+    if method == "workspace.list":
+        return {"type": "workspace_list", "workspaces": [{"workspace_id": space["id"], "label": space.get("name", space["id"]), "focused": False} for space in _listing().get("spaces", [])]}
+    if method == "workspace.create":
+        before = _pane(os.environ["HC_TERMINAL_ID"])
+        created = _app("space.new", name=params.get("label", "team"))
+        _app("space.select", id=before["workspace_id"])
+        return {"type": "workspace_created", "workspace_id": created["space"], "root_pane": {"pane_id": created["terminal"]}}
+    raise HerdrError("invalid_request", f"unknown method {method}")
