diff --git a/tests/test_hc_backend.py b/tests/test_hc_backend.py
new file mode 100644
index 0000000..e161c4a
--- /dev/null
+++ b/tests/test_hc_backend.py
@@ -0,0 +1,122 @@
+"""hc transport exercised through fake command-line programs only."""
+
+import json
+import os
+import sys
+
+import pytest
+
+from herdr_claude_teams import launcher, shim
+from _fake_herdr import FakeHerdr
+
+
+FAKE = r'''#!PYTHON
+import json, os, sys
+from pathlib import Path
+p = Path(os.environ["FAKE_HC_STATE"])
+s = json.loads(p.read_text())
+name = Path(sys.argv[0]).name
+a = sys.argv[1:]
+s["calls"].append([name, *a])
+out = {}
+if name == "herdr-app":
+    if a[0] == "ls":
+        out = {"spaces": s["spaces"]}
+    else:
+        command, args = a[1], json.loads(a[2])
+        if command == "tab.new":
+            tab = {"id": "tab" + str(len(s["spaces"][0]["tabs"]) + 1), "name": args["name"], "terminals": [{"terminal": "t2"}]}
+            s["spaces"][0]["tabs"].append(tab)
+            out = {"space": "s1", "tab": tab["id"], "terminal": "t2"}
+        elif command == "tab.move":
+            tabs = s["spaces"][0]["tabs"]
+            tab = next(t for t in tabs if t["id"] == args["id"])
+            tabs.remove(tab)
+            tabs.insert(args["index"] - 1, tab)
+        elif command == "tab.rename":
+            next(t for t in s["spaces"][0]["tabs"] if t["id"] == args["id"])["name"] = args["name"]
+elif a[0] == "get":
+    fg = s["foreground"].pop(0) if s["foreground"] else "sh"
+    out = {"address": a[1], "foreground": {"argv": [fg]}}
+elif a[0] == "read":
+    out = s["screen"]
+elif a[0] == "kill":
+    for space in s["spaces"]:
+        for tab in space["tabs"]:
+            tab["terminals"] = [t for t in tab["terminals"] if t["terminal"] != a[1]]
+elif a[0] not in ("interrupt", "send", "keys"):
+    sys.exit(2)
+p.write_text(json.dumps(s))
+sys.stdout.write(out if isinstance(out, str) else json.dumps(out) + "\n")
+'''
+
+
+@pytest.fixture
+def fake_hc(tmp_path, monkeypatch):
+    state = tmp_path / "state.json"
+    state.write_text(json.dumps({
+        "spaces": [{"id": "s1", "name": "work", "tabs": [
+            {"id": "tab1", "name": "lead", "terminals": [{"terminal": "t1"}]},
+            {"id": "tabx", "name": "other", "terminals": [{"terminal": "t9"}]},
+        ]}], "foreground": ["cat", "cat", "sh"], "screen": "teammate output\n", "calls": [],
+    }))
+    binary = tmp_path / "bin"
+    binary.mkdir()
+    for name in ("hc", "herdr-app"):
+        path = binary / name
+        path.write_text(FAKE.replace("#!PYTHON", f"#!{sys.executable}"))
+        path.chmod(0o755)
+    monkeypatch.setenv("PATH", str(binary) + os.pathsep + os.environ["PATH"])
+    monkeypatch.setenv("FAKE_HC_STATE", str(state))
+    monkeypatch.setenv("HC_TERMINAL_ID", "t1")
+    monkeypatch.setenv("HC_TERMINAL_SOCKET", "/fake/hc.sock")
+    monkeypatch.delenv("HERDR_ENV", raising=False)
+    monkeypatch.delenv("HERDR_SOCKET_PATH", raising=False)
+    return lambda: json.loads(state.read_text())
+
+
+def test_hc_launcher(fake_hc, monkeypatch):
+    monkeypatch.setenv("HERDR_CLAUDE_TEAMS_SHIM_DIR", "/fake/shim")
+    captured = []
+    launcher.main([], _exec=lambda f, a, e: captured.append(e))
+    assert captured[0]["TMUX_PANE"] == "%t1"
+    assert captured[0]["TMUX"].startswith("/fake/hc.sock,")
+
+
+def test_tui_socket_wins_when_hc_address_is_also_set(fake_hc, monkeypatch):
+    from herdr_claude_teams.socket_client import call
+
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        monkeypatch.setenv("HERDR_ENV", "1")
+        monkeypatch.setenv("HERDR_SOCKET_PATH", fake.path)
+        assert call("pane.get", {"pane_id": "wL-1"})["pane"]["terminal_id"] == "term_1"
+        assert fake.state.methods() == ["pane.get"]
+        assert fake_hc()["calls"] == []
+
+
+def test_hc_teammate_lifecycle(fake_hc, capsys, monkeypatch):
+    from herdr_claude_teams import ownership, verbs
+
+    monkeypatch.setattr(verbs, "PLACEHOLDER_POLL_SECONDS", 0.001)
+    assert shim.main(["split-window", "-t", "%t1", "-h", "-P", "-F", "#{pane_id}", "cat"]) == 0
+    assert capsys.readouterr().out.strip() == "%t2"
+    state = fake_hc()
+    assert [t["id"] for t in state["spaces"][0]["tabs"]] == ["tab1", "tab3", "tabx"]
+    assert [c for c in state["calls"] if c[:3] == ["herdr-app", "do", "tab.new"]]
+    assert not any(c[1] == "send" for c in state["calls"])
+    assert json.loads((ownership.owned_dir() / "t1.json").read_text()) == ["t2"]
+
+    assert shim.main(["respawn-pane", "-k", "-t", "%t2", "claude --agent-name alpha"]) == 0
+    calls = fake_hc()["calls"]
+    assert [c[1] for c in calls if c[0] == "hc"] == ["interrupt", "get", "get", "get", "send"]
+    assert [c for c in calls if c[:2] == ["hc", "send"]][-1] == ["hc", "send", "t2", "claude --agent-name alpha"]
+
+    assert shim.main(["capture-pane", "-p", "-t", "%t2"]) == 0
+    assert capsys.readouterr().out == "teammate output\n"
+    assert [c for c in fake_hc()["calls"] if c[:2] == ["hc", "read"]][-1] == ["hc", "read", "--lines", "0", "t2"]
+
+    assert shim.main(["kill-pane", "-t", "%t9"]) == 0
+    assert not any(c[:3] == ["hc", "kill", "t9"] for c in fake_hc()["calls"])
+    assert shim.main(["kill-pane", "-t", "%t2"]) == 0
+    assert [c for c in fake_hc()["calls"] if c[:2] == ["hc", "kill"]] == [["hc", "kill", "t2"]]
+    assert json.loads((ownership.owned_dir() / "t1.json").read_text()) == []
