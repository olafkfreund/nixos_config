--- /dev/null
+++ b/herdr_claude_teams/ownership.py
@@ -0,0 +1,80 @@
+"""Record which panes the shim created, so teardown only touches those.
+
+One file per leader pane: ``$XDG_RUNTIME_DIR/herdr-claude-teams/<leader>.owned``,
+one ``socket<TAB>pane_id<TAB>terminal_id`` line per teammate pane.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import os
+import tempfile
+from pathlib import Path
+
+
+def owned_dir() -> Path:
+    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
+    return Path(base) / "herdr-claude-teams"
+
+
+def _leader_file() -> Path | None:
+    leader = os.environ.get("HERDR_PANE_ID")
+    if not leader:
+        return None
+    return owned_dir() / f"{leader.replace('/', '_')}.owned"
+
+
+def _entries(path: Path) -> list[tuple[str, str, str]]:
+    try:
+        lines = path.read_text(encoding="utf-8").splitlines()
+    except OSError:
+        return []
+    rows = []
+    for line in lines:
+        parts = line.split("\t")
+        if len(parts) == 3:
+            rows.append((parts[0], parts[1], parts[2]))
+    return rows
+
+
+def record(pane: dict) -> None:
+    path = _leader_file()
+    if path is None:
+        return
+    row = "\t".join(
+        (os.environ.get("HERDR_SOCKET_PATH", ""), pane.get("pane_id", ""), pane.get("terminal_id", ""))
+    )
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "a", encoding="utf-8") as handle:
+        fcntl.flock(handle, fcntl.LOCK_EX)
+        handle.write(row + "\n")
+
+
+def is_owned(terminal_id: str) -> bool:
+    if not terminal_id:
+        return False
+    socket_path = os.environ.get("HERDR_SOCKET_PATH", "")
+    for path in owned_dir().glob("*.owned"):
+        for sock, _pane, term in _entries(path):
+            if sock == socket_path and term == terminal_id:
+                return True
+    return False
+
+
+def forget(terminal_id: str) -> None:
+    if not terminal_id:
+        return
+    socket_path = os.environ.get("HERDR_SOCKET_PATH", "")
+    for path in owned_dir().glob("*.owned"):
+        try:
+            handle = open(path, "r+", encoding="utf-8")
+        except OSError:
+            continue
+        with handle:
+            fcntl.flock(handle, fcntl.LOCK_EX)
+            rows = _entries(path)
+            kept = [r for r in rows if not (r[0] == socket_path and r[2] == terminal_id)]
+            if len(kept) != len(rows):
+                handle.seek(0)
+                handle.truncate()
+                handle.write("".join("\t".join(r) + "\n" for r in kept))
