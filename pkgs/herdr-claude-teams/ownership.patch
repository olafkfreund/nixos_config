new file mode 100644
index 0000000..397fa63
--- /dev/null
+++ b/tests/test_ownership.py
@@ -0,0 +1,141 @@
+"""Ownership: teardown touches only panes the shim created; respawn waits for cat."""
+
+from __future__ import annotations
+
+import pytest
+
+from _fake_herdr import FakeHerdr
+from herdr_claude_teams import launcher, shim, verbs
+
+
+class _ExecCalled(Exception):
+    def __init__(self, env):
+        self.env = env
+
+
+def _rec_exec(file, args, env):
+    raise _ExecCalled(env)
+
+
+def run(fake, monkeypatch, capsys, argv):
+    monkeypatch.setenv("HERDR_SOCKET_PATH", fake.path)
+    code = shim.main(argv)
+    return code, capsys.readouterr().out
+
+
+def test_foreign_kill_pane_refused_and_owned_closes(monkeypatch, capsys):
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        run(fake, monkeypatch, capsys, ["split-window", "-t", "%term_1", "-h", "-P", "-F", "#{pane_id}"])
+        fake.state.handle("pane.split", {"target_pane_id": "wL-1"})  # not made by the shim: wL-3 / term_3
+        code, _ = run(fake, monkeypatch, capsys, ["kill-pane", "-t", "%term_3"])
+        assert code == 0
+        terms = {p["terminal_id"] for p in fake.state.panes}
+        assert "term_3" in terms
+        code, _ = run(fake, monkeypatch, capsys, ["kill-pane", "-t", "%term_2"])
+        assert code == 0
+        assert {p["terminal_id"] for p in fake.state.panes} == {"term_1", "term_3"}
+        assert [m for m in fake.state.methods() if m == "pane.close"] == ["pane.close"]
+
+
+def test_kill_window_and_kill_session_send_no_rpc(monkeypatch, capsys):
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        for argv in (["kill-window", "-t", "wL:1"], ["kill-session", "-t", "fake"]):
+            code, _ = run(fake, monkeypatch, capsys, argv)
+            assert code == 0
+        assert fake.state.requests == []
+
+
+def test_respawn_waits_for_cat_then_sends(monkeypatch, capsys):
+    monkeypatch.setattr(verbs, "PLACEHOLDER_POLL_SECONDS", 0.001)
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        run(fake, monkeypatch, capsys, ["split-window", "-t", "%term_1", "-h", "-P", "-F", "#{pane_id}"])
+        fake.state.requests.clear()
+        fake.state.fg_queue = [[["cat"]], [["/run/current-system/sw/bin/cat"]], [["zsh"]]]
+        run(fake, monkeypatch, capsys, ["respawn-pane", "-k", "-t", "%term_2", "cd /x && claude"])
+        methods = fake.state.methods()
+        assert methods.count("pane.process_info") == 3
+        last = max(i for i, m in enumerate(methods) if m == "pane.process_info")
+        sends = [i for i, m in enumerate(methods) if m == "pane.send_text"]
+        assert sends[0] < methods.index("pane.process_info") and sends[1] > last
+
+
+def test_respawn_wait_times_out_and_still_sends(monkeypatch, capsys):
+    monkeypatch.setattr(verbs, "PLACEHOLDER_POLL_SECONDS", 0.001)
+    monkeypatch.setattr(verbs, "PLACEHOLDER_WAIT_SECONDS", 0.02)
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        run(fake, monkeypatch, capsys, ["split-window", "-t", "%term_1", "-h", "-P", "-F", "#{pane_id}"])
+        fake.state.fg_queue = [[["cat"]]] * 100000
+        run(fake, monkeypatch, capsys, ["respawn-pane", "-k", "-t", "%term_2", "cd /x && claude"])
+        assert fake.state.pane_text["wL-2"].endswith("cd /x && claude\r")
+
+
+def test_select_layout_sends_no_rpc(monkeypatch, capsys):
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        for _ in range(3):
+            run(fake, monkeypatch, capsys, ["split-window", "-t", "%term_1", "-h"])
+        fake.state.requests.clear()
+        code, _ = run(fake, monkeypatch, capsys, ["select-layout", "-t", "wL:1", "main-vertical"])
+        assert code == 0
+        assert fake.state.requests == []
+
+
+def test_respawn_labels_teammate(monkeypatch, capsys):
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        run(fake, monkeypatch, capsys, ["split-window", "-t", "%term_1", "-h", "-P", "-F", "#{pane_id}"])
+        run(fake, monkeypatch, capsys, ["respawn-pane", "-t", "%term_2",
+                                         "cd /x && env A=1 claude --agent-id alpha@t --agent-name alpha --foo"])
+        assert fake.state.pane("wL-2")["tokens"] == {"split_mark": "↳ alpha"}
+
+
+def test_label_failure_does_not_block_launch(monkeypatch, capsys):
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        run(fake, monkeypatch, capsys, ["split-window", "-t", "%term_1", "-h", "-P", "-F", "#{pane_id}"])
+        fake.state.fail("pane.report_metadata")
+        code, _ = run(fake, monkeypatch, capsys,
+                      ["respawn-pane", "-t", "%term_2", "claude --agent-name alpha"])
+        assert code == 0
+        assert fake.state.pane_text["wL-2"] == "claude --agent-name alpha\r"
+
+
+def test_launcher_writes_no_shim_when_dir_given(monkeypatch, tmp_path):
+    with FakeHerdr(leader_pane="wX-1") as fake:
+        fake.state.aliases["p_5"] = "wX-1"
+        monkeypatch.setenv("HERDR_ENV", "1")
+        monkeypatch.setenv("HERDR_SOCKET_PATH", fake.path)
+        monkeypatch.setenv("HERDR_PANE_ID", "p_5")
+        monkeypatch.setenv("HOME", str(tmp_path))
+        monkeypatch.setenv("XDG_CACHE_HOME", str(tmp_path / ".cache"))
+        monkeypatch.setenv("HERDR_CLAUDE_TEAMS_SHIM_DIR", "/store/shim")
+        with pytest.raises(_ExecCalled) as ei:
+            launcher.main([], _exec=_rec_exec)
+        assert ei.value.env["PATH"].startswith("/store/shim:")
+        assert not (tmp_path / ".cache").exists()
+
+
+def test_empty_terminal_id_never_owned(monkeypatch):
+    from herdr_claude_teams import ownership
+
+    monkeypatch.setenv("HERDR_SOCKET_PATH", "/s")
+    ownership.record({"pane_id": "w1:p2"})  # new-window root pane without a terminal_id
+    assert not ownership.is_owned("")
+    ownership.forget("")
+    assert ownership.owned_dir().joinpath("p_lead.owned").read_text().count("\n") == 1
+
+
+def test_respawn_refused_for_foreign_pane(monkeypatch, capsys):
+    with FakeHerdr(leader_pane="wL-1") as fake:
+        fake.state.handle("pane.split", {"target_pane_id": "wL-1"})  # not made by the shim
+        code, _ = run(fake, monkeypatch, capsys, ["respawn-pane", "-k", "-t", "%term_2", "claude"])
+        assert code == 0
+        assert "pane.send_text" not in fake.state.methods()
+
+
+def test_launcher_falls_back_to_plain_claude_when_leader_unresolved(monkeypatch, tmp_path):
+    with FakeHerdr(leader_pane="wX-1") as fake:
+        monkeypatch.setenv("HERDR_ENV", "1")
+        monkeypatch.setenv("HERDR_SOCKET_PATH", fake.path)
+        monkeypatch.setenv("HERDR_PANE_ID", "p_missing")
+        called = []
+        code = launcher.main(["--x"], _exec=_rec_exec, _exec_plain=lambda f, a: called.append((f, a)))
+        assert called == [("claude", ["claude", "--x"])]
+        assert code == 127
