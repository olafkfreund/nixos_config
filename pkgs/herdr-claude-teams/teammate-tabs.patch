+def _place_after_lead(new_tab_id: str | None, lead_tab_id: str, workspace_id: str) -> None:
+    """Move the new tab right after the lead's tab, behind teammates already there."""
+    try:
+        tabs = call("tab.list", {"workspace_id": workspace_id})["tabs"]
+        owned = {p["tab_id"] for p in call("pane.list", {})["panes"]
+                 if ownership.is_owned(p.get("terminal_id", ""))}
+        order = [t["tab_id"] for t in tabs if t["tab_id"] != new_tab_id]
+        # insert_index is assumed 0-based (list position); confirm live.
+        index = order.index(lead_tab_id) + 1
+        while index < len(order) and order[index] in owned:
+            index += 1
+        call("tab.move", {"tab_id": new_tab_id, "insert_index": index})
+    except Exception as exc:  # noqa: BLE001 - placement is cosmetic
+        trace.log("tab_move_failed", error=str(exc))
+
+
 def _send_keys(parsed) -> int:
