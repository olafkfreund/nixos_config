+    files = [str((plugin / name).as_uri()) for name in names]
     shell = Path(os.environ.get('OMARCHY_PATH', '/usr/share/omarchy')) / 'shell'
     with tempfile.TemporaryDirectory(prefix='omapop-plugin-load-') as directory:
